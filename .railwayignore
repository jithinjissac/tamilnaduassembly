# Railway Ignore File
# Files and folders that Railway should NOT deploy

# Documentation
*.md
!README.md

# Git
.git
.gitignore

# Environment files (use Railway variables instead)
.env
.env.local
.env.*.local

# Dependencies (Railway will install from package.json)
node_modules

# Logs
*.log
npm-debug.log*
logs

