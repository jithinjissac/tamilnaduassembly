generated-pdfs/*
!generated-pdfs/.gitkeep

# Uploads
uploads/*
!uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode
.idea
*.swp
*.swo

# Testing
test
tests
__tests__
coverage

