{
  "name": "kerala-sec-voter-api",
  "version": "1.0.0",
  "description": "Kerala SEC Voter List Extraction API with Playwright automation",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "npm run protect:safe && cross-env USE_PROTECTED=true NODE_ENV=production node server.js",
    "start:dev": "node server.js",
    "start:production": "npm run protect:safe && cross-env USE_PROTECTED=true node server.js",
    "dev": "nodemon server.js",
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "protect": "node build-scripts/obfuscate-inline.cjs",
    "protect:safe": "node build-scripts/obfuscate-safe.cjs",
    "serve:protected": "npm run protect:safe && cross-env USE_PROTECTED=true node server.js",
    "verify:deployment": "node verify-deployment.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "kerala",
    "sec",
    "voter",
    "election",
    "playwright",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "cashfree-pg": "^5.1.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-validator": "^7.3.0",
    "html-pdf-node": "^1.0.8",
    "javascript-obfuscator": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.17.2",
    "playwright": "^1.40.0",
    "puppeteer": "^24.29.1",
    "razorpay": "^2.9.6",
    "snappy": "^7.3.3",
    "ua-parser-js": "^2.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.5",
    "nodemon": "^3.0.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-obfuscator": "^3.5.1"
  }
